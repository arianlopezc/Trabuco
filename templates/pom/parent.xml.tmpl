<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>{{.GroupID}}</groupId>
    <artifactId>{{.ArtifactID}}-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>{{.ProjectNamePascal}} Parent</name>
    <description>Multi-module aggregator for {{.ProjectNamePascal}}</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>{{.JavaVersion}}</maven.compiler.source>
        <maven.compiler.target>{{.JavaVersion}}</maven.compiler.target>
        <!-- Spring Boot 4.1.x (Spring Framework 7.0, Spring Security 7.1,
             Spring Data 2026.0, Jackson 3). The 4.1 line is in open-source
             support until 2027-07-31 and officially supports Java 17–26;
             Java 27 is best-effort upstream and verified by Trabuco's own CI
             matrix. Jackson 3 (tools.jackson.*) is the default JSON stack:
             java.time / Optional support is built in and the generated code
             uses the Jackson 3 annotations on Immutables types. -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!-- Mockito: Spring Boot 4.1 manages 5.23.0 (Byte Buddy 1.18.11).
             Mockito 5.24 is the first release that officially lists Java 27
             class files; pinning it keeps mocks working when the compile
             target or the developer's runtime JVM is newer than what the BOM
             was built for. -->
        <mockito.version>5.24.0</mockito.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- CVE patch lines (see the dependencyManagement note below). Tomcat
             11.0.25+ and Jackson 3.1.7 / 2.21.7 are the first releases that
             close the advisories published against the versions Spring Boot
             4.1.1 manages. Jackson 2 is still on the classpath for libraries
             that have not moved to tools.jackson yet (springdoc, bucket4j). -->
        <tomcat.version>11.0.27</tomcat.version>
        <jackson3.version>3.1.7</jackson3.version>
        <jackson2.version>2.21.7</jackson2.version>
        <!-- RabbitMQ Java client: Spring Boot 4.1.1 manages 5.30.0, which has
             CVE-2026-63335/63336/63337, 69219/69220, 75516 and 106121-106123
             published against it; 5.36.1+ closes all of them. Only resolved
             when the RabbitMQ broker is selected. -->
        <rabbitmq-amqp-client.version>5.37.0</rabbitmq-amqp-client.version>
        <!-- lz4-java (transitive of kafka-clients 4.2.x, which ships 1.10.1):
             CVE-2026-59949 and CVE-2026-106449..106453 are fixed in 1.11.4+.
             Only resolved when the Kafka broker is selected. -->
        <lz4-java.version>1.12.0</lz4-java.version>
{{- if or (.HasModule "Jobs") (.HasModule "Worker")}}
        <!-- JobRunr 9.x ships the jobrunr-spring-boot-4-starter and is built
             against Spring Boot 4 / Jackson 3. (8.x was the last line with a
             Spring Boot 3 starter.) -->
        <jobrunr.version>9.0.1</jobrunr.version>
{{- end}}
{{- if or (or (or (.HasModule "API") (.HasModule "Worker")) (.HasModule "EventConsumer")) (.HasAIAgentModule)}}
        <!-- logstash-logback-encoder 9.x is built on Jackson 3 (tools.jackson),
             matching Spring Boot 4's JSON stack. -->
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
{{- end}}
{{- if .HasModule "API"}}
        <!-- springdoc 3.1.x is the line built against Spring Boot 4.1
             (3.0.x ↔ Boot 4.0, 2.8.x ↔ Boot 3.5). -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- bucket4j-spring-boot-starter 0.13+ targets Spring Boot 4. -->
        <bucket4j.version>0.14.0</bucket4j.version>
{{- end}}
{{- if or (or (or (.HasModule "API") (.HasModule "Worker")) (.HasModule "EventConsumer")) (.HasAIAgentModule)}}
        <!-- OpenTelemetry — instrumentation BOM for HTTP, JDBC, Kafka,
             RabbitMQ, JobRunr, and the JVM. Off by default; users enable
             by setting OTEL_TRACES_EXPORTER=otlp and pointing
             OTEL_EXPORTER_OTLP_ENDPOINT at a collector. -->
        <opentelemetry.version>2.32.0</opentelemetry.version>
{{- end}}
{{- if .HasAIAgentModule}}
        <!-- Spring AI 2.0.x is the line built against Spring Boot 4 (1.x
             lines reached end of OSS support on 2026-06-30). The Anthropic
             module now wraps the official anthropic-java SDK; chat options
             live directly under spring.ai.anthropic.chat.*. -->
        <spring-ai.version>2.0.1</spring-ai.version>
{{- end}}
{{- if or (.HasModule "Shared") (.HasAIAgentModule)}}
        <!-- Resilience4j: declared here as the canonical version source
             so Shared, AIAgent and any downstream module that pulls
             Resilience4j stay in lockstep. 2.4.0 is the first release
             with the resilience4j-spring-boot4 starter. -->
        <resilience4j.version>2.4.0</resilience4j.version>
{{- end}}
        <!-- JaCoCo instruments class files with its own ASM, so it must know
             every class-file version it meets: 0.8.14 added Java 25 (major 69),
             0.8.15 adds official Java 26 and experimental Java 27 support. An
             older agent fails with `Unsupported class file major version N`,
             producing log noise and missing coverage data. -->
        <jacoco.version>0.8.15</jacoco.version>
        <maven-enforcer.version>3.6.3</maven-enforcer.version>
        <!-- Spotless 3.x requires Java 17+ and ships a newer
             google-java-format; it is not bound to a build phase (see the
             plugin block below), so a format change never breaks `mvn verify`. -->
        <spotless.version>3.10.4</spotless.version>
        <!-- ArchUnit bundles its own ASM, so it must know every class-file
             version it imports — otherwise it logs "Unsupported class file
             major version" per JDK class and falls back to a degraded importer,
             producing stack-trace spam in test logs. 1.4.1 added Java 25,
             1.4.2 Java 26, 1.5.0 Java 27 (class-file major version 71). -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <modules>
{{- range .Modules}}
        <module>{{.}}</module>
{{- end}}
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- ── Security patch pins (override Spring Boot's managed versions) ──
                 Spring Boot 4.1.1 manages Tomcat 11.0.24 and Jackson 3.1.5 /
                 2.21.5, which carry published CVEs (Tomcat: CVE-2026-65182,
                 CVE-2026-65905, CVE-2026-68525; Jackson: CVE-2026-68497,
                 CVE-2026-89407, CVE-2026-89425, CVE-2026-91776, CVE-2026-91777).
                 Explicit entries in this POM's dependencyManagement take
                 precedence over anything an imported BOM manages, so the
                 patched releases below win for every module. Re-check these
                 pins (and drop them) when the Spring Boot line catches up. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rabbitmq</groupId>
                <artifactId>amqp-client</artifactId>
                <version>${rabbitmq-amqp-client.version}</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <!-- Jackson BOMs are imported BEFORE spring-boot-dependencies: for
                 imported BOMs the first one that manages an artifact wins. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers core - explicit version to override Spring Boot managed version -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
{{- if or (or (or (.HasModule "API") (.HasModule "Worker")) (.HasModule "EventConsumer")) (.HasAIAgentModule)}}
            <!-- OpenTelemetry instrumentation BOM — pins the instrumentation
                 modules AND the matching OpenTelemetry SDK (opentelemetry-bom).
                 It is imported BEFORE spring-boot-dependencies on purpose: Maven
                 honours the first BOM that manages an artifact, and Spring
                 Boot's BOM pins an older opentelemetry-bom than the
                 instrumentation starter was built against. Letting Boot win
                 would mix SDK/API versions and trip the dependencyConvergence
                 rule. -->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
{{- end}}
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Testcontainers BOM - imported after Spring Boot for additional modules -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
{{- if .UsesSQS}}
            <!-- Spring Cloud AWS BOM — 4.x is the line built against Spring
                 Boot 4 (3.4.x ↔ Boot 3.5). 4.2.x targets Boot 4.1 and uses
                 Jackson 3 for the SQS message converter. -->
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>4.2.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
{{- else if .UsesPubSub}}
            <!-- Spring Cloud GCP BOM — 8.x is the line built against Spring
                 Boot 4 (7.x ↔ Boot 3.5); 8.2.4 is built on Boot 4.1.1 and its
                 Pub/Sub Jackson converter takes a Jackson 3 ObjectMapper. -->
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>spring-cloud-gcp-dependencies</artifactId>
                <version>8.2.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
{{- end}}
{{- if .HasAIAgentModule}}
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
{{- end}}
{{- if or (or (or (.HasModule "API") (.HasModule "Worker")) (.HasModule "EventConsumer")) (.HasAIAgentModule)}}
            <!-- OTel ships several modules on independent alpha-version cycles
                 that the instrumentation BOM does not pin (semconv, api-incubator,
                 contrib resource detectors). Maven enforcer's
                 dependencyConvergence rule rejects the resulting mismatches, so
                 each one is pinned explicitly here. Versions are aligned with
                 the instrumentation BOM above (2.32.0 ↔ opentelemetry-bom
                 1.66.0, semconv 1.44.0). -->
            <dependency>
                <groupId>io.opentelemetry.semconv</groupId>
                <artifactId>opentelemetry-semconv</artifactId>
                <version>1.44.0</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api-incubator</artifactId>
                <version>1.66.0-alpha</version>
            </dependency>
{{- end}}
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- checker-qual: pin to resolve dependencyConvergence conflicts
                 between transitive consumers (e.g., postgresql driver pulls a
                 newer version than Google Cloud Pub/Sub's proto libraries).
                 It's a compile-time annotation library; any recent version
                 is safe across all consumers. -->
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>3.48.3</version>
            </dependency>
            <!-- Mockito: Spring Boot 4.1 manages mockito-core at 5.23.0. Pin the
                 release that officially lists Java 27 class files so developers
                 running a newer JDK than the BOM was built for do not hit Byte
                 Buddy "could not instrument" errors. The `<mockito.version>`
                 property by itself does not override the version that Spring
                 Boot's spring-boot-dependencies BOM locks in. -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
            </dependency>
{{- if .HasAIAgentModule}}
            <!-- Spring AI 2.0 transitives (spring-ai-model / client-chat vs the
                 official anthropic-java SDK, plus the OpenTelemetry resource
                 detectors) request different versions of these libraries.
                 Maven Enforcer's dependencyConvergence rule fails the build
                 until every path agrees, so the highest version on any path
                 is pinned here. Tied to spring-ai 2.0.1 + anthropic-java 2.52.
                 Re-derive with `mvn validate -Denforcer.fail=false` after a
                 Spring AI bump. -->
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-generator</artifactId>
                <version>5.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-jackson</artifactId>
                <version>5.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.github.victools</groupId>
                <artifactId>jsonschema-module-swagger-2</artifactId>
                <version>5.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.18.1</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>3.18.1</version>
            </dependency>
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.50.0</version>
            </dependency>
{{- end}}
{{- if .VectorStoreIsQdrant}}
            <!-- Qdrant transitives bring conflicting versions of this Google
                 annotation lib across the grpc-* / gson paths. Maven Enforcer
                 (DependencyConvergence rule) fails the build until all paths
                 agree, so the highest version is pinned here. protobuf-java
                 itself is NOT pinned: Spring Boot 4.1 manages protobuf-java and
                 protobuf-java-util together (4.35.x), and forcing an older
                 protobuf-java under the qdrant-client 1.18 generated stubs
                 breaks at runtime. Tied to spring-ai 2.0.1. -->
            <dependency>
                <groupId>com.google.j2objc</groupId>
                <artifactId>j2objc-annotations</artifactId>
                <version>3.0.0</version>
            </dependency>
{{- end}}
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <release>{{.JavaVersion}}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- Java 21 deprecated dynamic Java-agent attachment
                             and Java 24+ disables it by default. Mockito's
                             inline mock-maker attaches Byte Buddy as a
                             dynamic agent to mock concrete classes — without
                             this flag, tests that mock non-interface types
                             fail with "Byte Buddy could not instrument all
                             classes" when the developer's runtime JVM is
                             newer than the compile target.
                             `@{argLine}` is late-binding so Jacoco's
                             prepare-agent can still prepend coverage
                             instrumentation. -->
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer.version}</version>
                <configuration>
                    <rules>
                        <requireMavenVersion>
                            <version>[3.8,)</version>
                        </requireMavenVersion>
                        <requireJavaVersion>
                            <version>[{{.JavaVersion}},)</version>
                        </requireJavaVersion>
                        <bannedDependencies>
                            <excludes>
                                <exclude>javax.*:*</exclude>
                                <exclude>junit:junit</exclude>
                            </excludes>
                            <includes>
                                <!-- JCache (JSR-107) was never migrated to jakarta.* — it's a
                                     separate JSR, not part of Jakarta EE. Bucket4j and many other
                                     caching libraries depend on javax.cache:cache-api transitively. -->
                                <include>javax.cache:cache-api</include>
                                <!-- Bean Validation 2.0 (JSR-380, javax.validation:validation-api)
                                     was migrated to jakarta.validation:jakarta.validation-api in
                                     Jakarta EE 9, but some libraries (e.g. OpenTelemetry's
                                     spring-boot-autoconfigure) still pull the legacy artifact
                                     for backward compatibility. The runtime uses jakarta.* —
                                     the legacy javax.* JAR sits unused on the classpath. -->
                                <include>javax.validation:validation-api</include>
                            </includes>
                            <message>Use jakarta.* instead of javax.* and JUnit 5 instead of JUnit 4 (javax.cache:cache-api is allowed — JCache JSR-107 was not migrated to jakarta.*)</message>
                        </bannedDependencies>
                        <dependencyConvergence/>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals><goal>enforce</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat/>
                        <removeUnusedImports/>
                    </java>
                </configuration>
                <!--
                    Spotless is configured but NOT bound to a build phase
                    by default. Run manually:
                      mvn spotless:apply   # rewrite all files in place
                      mvn spotless:check   # report violations (CI gate)
                    To enforce on every build, add:
                      <executions>
                        <execution>
                          <phase>verify</phase>
                          <goals><goal>check</goal></goals>
                        </execution>
                      </executions>
                    The reason it's not bound here: enabling check on
                    verify means any formatting violation breaks
                    `mvn verify` mid-development, which surprises users
                    who expect verify to test correctness, not style.
                    Operators who want strict enforcement add the binding
                    in their downstream POM.
                -->
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- OWASP dependency-check: NVD-backed CVE scanner. Off by
             default because the first run downloads ~1 GB of NVD data
             and CVE scans add minutes to the build. The scheduled
             `.github/workflows/security-audit.yml` runs `mvn -Psecurity-audit
             verify` weekly. Operators can run it locally any time:
             `mvn -Psecurity-audit verify -DnvdApiKey=$NVD_API_KEY`.
             Set NVD_API_KEY (free, https://nvd.nist.gov/developers/request-an-api-key)
             to dramatically speed up the database refresh — without it the
             rate-limited public endpoint serves the data 30x slower. -->
        <profile>
            <id>security-audit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <!-- Fail on CVSS >= 7 (HIGH or CRITICAL).
                                 Lowering this catches more issues at the
                                 cost of more triage. The suppressions
                                 file is the documented exception path. -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <suppressionFile>${maven.multiModuleProjectDirectory}/.dependency-check/suppressions.xml</suppressionFile>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <!-- Cache the NVD database under .m2 so weekly
                                 CI runs don't re-download. -->
                            <dataDirectory>${user.home}/.m2/dependency-check-data</dataDirectory>
                            <!-- Skip dev/test scopes — they don't ship
                                 with production jars. -->
                            <skipTestScope>true</skipTestScope>
                            <skipProvidedScope>true</skipProvidedScope>
                            <!-- HTML + JSON outputs for CI artifact upload. -->
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
