{{- else if eq .NoSQLDatabase "redis"}}
import {{.GroupID}}.model.entities.PlaceholderDocument;
import tools.jackson.databind.json.JsonMapper;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.repository.configuration.EnableRedisRepositories;
import org.springframework.data.redis.serializer.JacksonJsonRedisSerializer;
import org.springframework.data.redis.serializer.StringRedisSerializer;

/**
 * Redis configuration.
 *
 * <p>Enables Redis repositories and configures the Redis connection.
 * Uses Lettuce as the default client (thread-safe, async-capable).
 *
 * <h2>Serializer choice</h2>
 *
 * <p>Earlier releases used {@code GenericJacksonJsonRedisSerializer},
 * which embeds {@code @class} type markers in the stored JSON and
 * trusts those markers when reading back. That makes any FQCN on the
 * classpath an instantiation primitive — a Redis key smuggled in by a
 * compromised neighbour, a backup-restore that includes hostile
 * payloads, or an attacker with line-of-sight to the Redis port could
 * drive deserialization into a gadget class. Since 1.12 the template
 * uses a type-bound {@link JacksonJsonRedisSerializer} — the
 * deserializer always materialises {@code PlaceholderDocument},
 * regardless of any embedded type hint. Replace the bound type with
 * your real domain entity when you remove the placeholder, or
 * Register a per-template serializer per stored type.
 */
@Configuration
@EnableRedisRepositories(basePackages = "{{.GroupID}}.nosqldatastore.repository")
public class NoSQLConfig {

  /**
   * Dedicated Jackson 3 mapper for Redis values. Kept separate from the
   * auto-configured web {@code JsonMapper} so HTTP-facing customisations
   * never change the on-the-wire format of cached entries. Jackson 3
   * mappers are immutable (configure through the builder, then build) and
   * already write java.time values as ISO-8601 strings by default, so no
   * JavaTimeModule registration or WRITE_DATES_AS_TIMESTAMPS toggle is
   * needed.
   */
  @Bean
  public JsonMapper redisObjectMapper() {
    return JsonMapper.builder().build();
  }

  @Bean
  public RedisTemplate<String, Object> redisTemplate(RedisConnectionFactory connectionFactory, JsonMapper redisObjectMapper) {
    RedisTemplate<String, Object> template = new RedisTemplate<>();
    template.setConnectionFactory(connectionFactory);
    template.setKeySerializer(new StringRedisSerializer());
    JacksonJsonRedisSerializer<PlaceholderDocument> typed =
        new JacksonJsonRedisSerializer<>(redisObjectMapper, PlaceholderDocument.class);
    template.setValueSerializer(typed);
    template.setHashKeySerializer(new StringRedisSerializer());
    template.setHashValueSerializer(typed);
    template.afterPropertiesSet();
    return template;
  }
}
{{- end}}
